{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BlueFantasy parts.json",
  "description": "GLB 节点名与装配/爆炸位。每个零件对应场景中的一个 Group。",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "assembled",
      "exploded"
    ],
    "properties": {
      "name": {
        "type": "string",
        "enum": [
          "hull_shell",
          "ship_deck",
          "keel",
          "stem",
          "sternpost",
          "bulkhead_01",
          "bulkhead_02",
          "bulkhead_03",
          "plank_seam",
          "treenail",
          "iron_nail",
          "caulking_seam",
          "joint_tenon",
          "joint_mortise"
        ]
      },
      "assembled": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 3,
        "maxItems": 3
      },
      "exploded": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 3,
        "maxItems": 3
      },
      "label": {
        "type": "string"
      }
    }
  }
}
